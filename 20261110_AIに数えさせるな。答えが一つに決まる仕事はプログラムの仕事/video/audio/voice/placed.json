[
 {
  "cut": "01",
  "text": "たくさんのファイルをまとめて渡すと、",
  "design": 0.3,
  "start": 0.47,
  "end": 2.6
 },
 {
  "cut": "01",
  "text": "「問題ありません」と返ってきました。",
  "design": 3.0,
  "start": 2.83,
  "end": 5.17
 },
 {
  "cut": "02",
  "text": "人の目で確かめると、",
  "design": 7.8,
  "start": 7.89,
  "end": 9.4
 },
 {
  "cut": "02",
  "text": "見ていないファイルに、",
  "design": 9.4,
  "start": 9.57,
  "end": 10.72
 },
 {
  "cut": "02",
  "text": "大事な変更が残っていました。",
  "design": 11.11,
  "start": 10.94,
  "end": 12.84
 },
 {
  "cut": "03",
  "text": "手を抜いた、と受け取られがちです。",
  "design": 14.3,
  "start": 14.28,
  "end": 16.81
 },
 {
  "cut": "03",
  "text": "私は、苦手な渡し方だったと考えています。",
  "design": 17.3,
  "start": 17.32,
  "end": 20.78
 },
 {
  "cut": "04",
  "text": "AIには、注意力の予算があります。",
  "design": 22.4,
  "start": 22.32,
  "end": 24.88
 },
 {
  "cut": "04",
  "text": "読めても目は配れず、書いてあっても読み飛ばします。",
  "design": 25.34,
  "start": 25.42,
  "end": 28.96
 },
 {
  "cut": "05",
  "text": "最初と最後は答えられても、",
  "design": 30.0,
  "start": 30.18,
  "end": 32.12
 },
 {
  "cut": "05",
  "text": "真ん中ほど見落とされ、",
  "design": 32.14,
  "start": 32.4,
  "end": 33.98
 },
 {
  "cut": "05",
  "text": "精度が大きく落ちます。",
  "design": 34.31,
  "start": 34.17,
  "end": 35.68
 },
 {
  "cut": "05",
  "text": "人でも、書類の山なら同じかもしれません。",
  "design": 36.49,
  "start": 36.23,
  "end": 39.2
 },
 {
  "cut": "06",
  "text": "「全部見ましたか」と念を押すより、",
  "design": 40.4,
  "start": 40.42,
  "end": 43.16
 },
 {
  "cut": "06",
  "text": "一つずつ渡します。",
  "design": 43.34,
  "start": 43.44,
  "end": 44.7
 },
 {
  "cut": "06",
  "text": "数だけ繰り返せば、全部に一度は目が通ります。",
  "design": 45.35,
  "start": 45.25,
  "end": 48.64
 },
 {
  "cut": "07",
  "text": "気になるものだけを次に渡し、問題なしはもう渡しません。",
  "design": 51.6,
  "start": 51.43,
  "end": 55.64
 },
 {
  "cut": "07",
  "text": "昔は手間で現実的ではなく、今は一つずつでも、コストはそれほどかかりません。",
  "design": 56.19,
  "start": 56.19,
  "end": 62.22
 },
 {
  "cut": "07",
  "text": "見落としようがない渡し方を、最初から選びます。",
  "design": 62.6,
  "start": 62.77,
  "end": 65.87
 },
 {
  "cut": "08",
  "text": "答えは毎回、少し揺れます。",
  "design": 67.2,
  "start": 67.12,
  "end": 69.74
 },
 {
  "cut": "08",
  "text": "一つに決まる仕事とは、別です。",
  "design": 70.21,
  "start": 70.29,
  "end": 72.64
 },
 {
  "cut": "09",
  "text": "差分、件数、文字数は、プログラムに任せます。",
  "design": 74.7,
  "start": 74.61,
  "end": 78.3
 },
 {
  "cut": "09",
  "text": "意味と影響の判断だけを、AIに渡します。",
  "design": 78.77,
  "start": 78.85,
  "end": 81.96
 },
 {
  "cut": "10",
  "text": "別のAIでの確認は、関門としては役に立ちます。",
  "design": 83.3,
  "start": 83.21,
  "end": 86.84
 },
 {
  "cut": "10",
  "text": "道具は、苦手なところにだけ足します。",
  "design": 87.31,
  "start": 87.4,
  "end": 90.21
 },
 {
  "cut": "11",
  "text": "急ぐのか、網羅するのか、",
  "design": 91.1,
  "start": 91.13,
  "end": 93.09
 },
 {
  "cut": "11",
  "text": "伝えないとAIには分かりません。",
  "design": 93.22,
  "start": 93.32,
  "end": 95.56
 },
 {
  "cut": "11",
  "text": "返信すべきかは、自分の事情が要ります。",
  "design": 96.22,
  "start": 96.12,
  "end": 98.82
 },
 {
  "cut": "12",
  "text": "任せたいのは、直感にしか頼めなかった判断です。",
  "design": 99.9,
  "start": 100.11,
  "end": 103.51
 },
 {
  "cut": "12",
  "text": "間違えても、前には進みます。",
  "design": 103.9,
  "start": 104.03,
  "end": 106.42
 },
 {
  "cut": "12",
  "text": "漏れなく拾う仕事は、AIだけだと負け戦になりやすい。",
  "design": 107.18,
  "start": 106.97,
  "end": 111.12
 },
 {
  "cut": "12",
  "text": "冒頭の確認は、こちらでした。",
  "design": 111.7,
  "start": 111.67,
  "end": 114.16
 },
 {
  "cut": "13",
  "text": "私は、能力より先に渡し方を見ます。",
  "design": 114.8,
  "start": 114.6,
  "end": 117.79
 },
 {
  "cut": "13",
  "text": "渡し方を疑ってみてください。",
  "design": 118.37,
  "start": 118.34,
  "end": 120.38
 },
 {
  "cut": "13",
  "text": "同じAIでも、聞き方で結果は変わります。",
