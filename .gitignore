# Ignore generated dependencies, tool caches, secrets, and heavy video exports.
# Planning docs, prompts, scripts, configs, and light reference assets stay
# commit-able: png, jpg, jpeg, svg, webp, wav, and mp3.

# Dependencies
node_modules

# Claude's isolated working copies are local tooling state.
/.claude/worktrees/

# Caches and build output
.cache/
__pycache__/
*.pyc
.pyc
*.pyo
*.pyd
dist/
build/
.next/
.remotion/
out/
.turbo/
.vercel/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
*.egg-info/
.eggs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
.pnp
.pnp.js
.pnp.cjs

# Remotion writes rendered media to out/ and its bundler cache to .remotion/.
# HyperFrames keeps final renders and intermediates in these locations.
/renders/
/snapshots/
/output/
/captures/
.debug/
hyperframes-extract-cache*/

# Blender render intermediates, diagnostic logs, and automatic backups.
# Keep editable .blend scenes, scripts, tracks, stills, and license records.
**/assets/blender/renders/
**/assets/blender/**/*.log
*.blend[0-9]*
*.blend@

# Rebuildable delivery archive; its source files remain separately available.
**/assets/blender-materials.zip

# OS junk
.DS_Store
Thumbs.db

# Local env files. Example templates are configs and stay commit-able.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Virtual environments
.venv/
venv/

# Heavy video exports. Applies anywhere, including Remotion out/ and
# HyperFrames renders/. Reference images and source audio are not ignored.
*.mp4
*.MP4
*.mov
*.MOV
*.mkv
*.MKV
*.webm
*.WEBM
*.avi
*.AVI

# Audio intermediates regenerated by bgm_build.py / mix_build.py (BGM uses a
# fixed seed). Final mixes (.m4a/.mp3) and narration audio stay commit-able
# so videos can be re-rendered without re-generating voices.
**/public/bgm.wav
**/audio/bgm.wav
**/public/mix.wav

