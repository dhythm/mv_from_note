[
  {
    "id": "p1a",
    "cut": 1,
    "start": 0.9,
    "end": 5.5,
    "text": "「いつか使うかもしれない」",
    "raw_duration": 1.750204,
    "trim_start": 0,
    "trim_end": 1.750204,
    "tempo": 1,
    "actual_end": 2.650204
  },
  {
    "id": "p1b",
    "cut": 1,
    "start": 5.2,
    "end": 10.0,
    "text": "そう言って、物もファイルも取っておく。",
    "raw_duration": 3.239184,
    "trim_start": 0,
    "trim_end": 3.239184,
    "tempo": 1,
    "actual_end": 8.439184000000001
  },
  {
    "id": "p2a",
    "cut": 2,
    "start": 10.05,
    "end": 13.7,
    "text": "「せっかく買ったのに」。",
    "raw_duration": 2.272653,
    "trim_start": 0,
    "trim_end": 2.272653,
    "tempo": 1,
    "actual_end": 12.322653
  },
  {
    "id": "p2b",
    "cut": 2,
    "start": 13.35,
    "end": 17.4,
    "text": "捨てられない気持ちを、サンクコストが強める。",
    "raw_duration": 3.892245,
    "trim_start": 0,
    "trim_end": 3.892245,
    "tempo": 1.118461206896552,
    "actual_end": 16.83
  },
  {
    "id": "p2c",
    "cut": 2,
    "start": 16.95,
    "end": 21.8,
    "text": "取っておく間に、劣化し、場所を占め、心の余裕まで圧迫する。",
    "raw_duration": 6.269388,
    "trim_start": 0,
    "trim_end": 6.269388,
    "tempo": 1.2926573195876285,
    "actual_end": 21.8
  },
  {
    "id": "p3a",
    "cut": 3,
    "start": 22.55,
    "end": 26.7,
    "text": "データは資産だ。",
    "raw_duration": 1.854694,
    "trim_start": 0,
    "trim_end": 1.854694,
    "tempo": 1,
    "actual_end": 24.404694
  },
  {
    "id": "p3b",
    "cut": 3,
    "start": 26.95,
    "end": 31.0,
    "text": "同時に、維持管理の負債でもある。",
    "raw_duration": 3.291429,
    "trim_start": 0,
    "trim_end": 3.291429,
    "tempo": 1,
    "actual_end": 30.241429
  },
  {
    "id": "p3c",
    "cut": 3,
    "start": 30.7,
    "end": 34.2,
    "text": "多いほど、たどり着きにくい。",
    "raw_duration": 2.925714,
    "trim_start": 0.06623599999999999,
    "trim_end": 2.925714,
    "tempo": 1,
    "actual_end": 33.559478
  },
  {
    "id": "p4a",
    "cut": 4,
    "start": 34.45,
    "end": 39.1,
    "text": "デジタルも同じだ。多すぎると、探せない。",
    "raw_duration": 4.545306,
    "trim_start": 0,
    "trim_end": 4.545306,
    "tempo": 1.0873937799043063,
    "actual_end": 38.63
  },
  {
    "id": "p4b",
    "cut": 4,
    "start": 38.75,
    "end": 43.9,
    "text": "検索できなければ、それはコストだ。",
    "raw_duration": 3.657143,
    "trim_start": 0,
    "trim_end": 3.5263720000000003,
    "tempo": 1,
    "actual_end": 42.276372
  },
  {
    "id": "p5a",
    "cut": 5,
    "start": 44.3,
    "end": 48.45,
    "text": "たどり着けないなら、宝の持ち腐れだ。",
    "raw_duration": 3.787755,
    "trim_start": 0,
    "trim_end": 3.787755,
    "tempo": 1,
    "actual_end": 48.087754999999994
  },
  {
    "id": "p5b",
    "cut": 5,
    "start": 48.25,
    "end": 54.0,
    "text": "必要なのは、捨てる勇気と、整理する習慣だ。",
    "raw_duration": 5.093878,
    "trim_start": 0,
    "trim_end": 5.093878,
    "tempo": 1,
    "actual_end": 53.343878000000004
  },
  {
    "id": "p6a",
    "cut": 6,
    "start": 54.3,
    "end": 58.55,
    "text": "ラグで、以前より探しやすくなることもある。",
    "raw_duration": 3.657143,
    "trim_start": 0,
    "trim_end": 3.443719,
    "tempo": 1,
    "actual_end": 57.743719
  },
  {
    "id": "p6b",
    "cut": 6,
    "start": 58.25,
    "end": 62.05,
    "text": "それでも、まだ届かないことは多い。",
    "raw_duration": 3.186939,
    "trim_start": 0,
    "trim_end": 3.040658,
    "tempo": 1,
    "actual_end": 61.290658
  },
  {
    "id": "p6c",
    "cut": 6,
    "start": 61.75,
    "end": 65.95,
    "text": "だから、見直しと削除が要る。",
    "raw_duration": 3.056327,
    "trim_start": 0,
    "trim_end": 2.887574,
    "tempo": 1,
    "actual_end": 64.637574
  },
  {
    "id": "p7a",
    "cut": 7,
    "start": 66.3,
    "end": 71.55,
    "text": "「いつか使うかもしれない」は、今の生産性を確実に下げる。",
    "raw_duration": 6.765714,
    "trim_start": 0.19551,
    "trim_end": 6.662812,
    "tempo": 1.1286739965095978,
    "actual_end": 72.03
  },
  {
    "id": "p7b",
    "cut": 7,
    "start": 72.15,
    "end": 78.0,
    "text": "定期的な見直しと、思い切った削除が、真の資産につながるのかもしれない。",
    "raw_duration": 6.29551,
    "trim_start": 0,
    "trim_end": 6.269388,
    "tempo": 1.0998926315789497,
    "actual_end": 77.85
  }
]